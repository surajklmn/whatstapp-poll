# WhatsApp Group JID (Find this from the printed list on first startup, ends with @g.us)
TARGET_GROUP_ID=

# 7:00 AM, Monday to Friday (Saturday & Sunday excluded)
# Format: Minute Hour Day-of-Month Month Day-of-Week(1-5 = Mon-Fri)
CRON_SCHEDULE=0 7 * * 1-5

# Timezone (Matches your local timezone UTC+05:45)
TIMEZONE=Asia/Kathmandu

# Food Poll Settings
POLL_QUESTION=Food today? 🍲
POLL_OPTIONS=Yes, No
POLL_SELECTABLE_COUNT=1
